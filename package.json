{
  "name": "score",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "bun --bun x ultracite check",
    "format": "bun --bun x ultracite fix",
    "check-types": "turbo run check-types",
    "check": "bun --bun x ultracite check",
    "fix": "bun --bun x ultracite fix",
    "prepare": "lefthook install",
    "dev:www": "turbo dev --filter=www"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-typescript": "^8.0.1",
    "@shadcn/lint": "^0.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-plugin-react-doctor": "^0.9.17",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "ultracite": "7.12.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5"
}
