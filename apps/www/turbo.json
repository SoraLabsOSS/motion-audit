{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$"],
      "env": ["NODE_ENV", "AI_GATEWAY_API_KEY", "AI_SEARCH_CHAT_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "!.next/node_modules/**"
      ]
    }
  }
}
